<Window x:Class="JASS.AlbertaSeniorCompanion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JASS Alberta Senior Companion v1.1" Width="1280" Height="840"
        MinWidth="1080" MinHeight="700" Background="#F5F8FB" FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource DarkBlue}">
      <Grid Margin="24,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="JASS Alberta Senior Companion" Foreground="White" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock Text="Senior services • benefits • health • CRA • safety • planning" Foreground="#D7E8F6" FontSize="13"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EAF4FB" CornerRadius="18" Padding="14,7">
          <TextBlock Text="ALBERTA • SENIORS" Foreground="{StaticResource DarkBlue}" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="18,14">
      <TabItem x:Name="DashboardTab" Header="🏠 Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="Your senior-services dashboard" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
          <TextBlock Text="A local-first organizer for benefits, health, tax, safety and important contacts." Margin="0,4,0,18" Foreground="{StaticResource Muted}" FontSize="15"/>
          <UniformGrid Columns="4">
            <Border Margin="6" Padding="18" Background="{StaticResource SoftRed}" CornerRadius="10"><StackPanel><TextBlock Text="🚨 Emergency" FontSize="18" FontWeight="Bold"/><TextBlock Text="911 • 811 • emergency assistance" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Margin="6" Padding="18" Background="{StaticResource SoftGreen}" CornerRadius="10"><StackPanel><TextBlock Text="💊 Health" FontSize="18" FontWeight="Bold"/><TextBlock Text="Coverage and care resources" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Margin="6" Padding="18" Background="{StaticResource SoftGold}" CornerRadius="10"><StackPanel><TextBlock Text="💰 Benefits" FontSize="18" FontWeight="Bold"/><TextBlock Text="Eligibility assistant and programs" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Margin="6" Padding="18" Background="{StaticResource SoftBlue}" CornerRadius="10"><StackPanel><TextBlock Text="🧾 CRA &amp; Tax" FontSize="18" FontWeight="Bold"/><TextBlock Text="Filing, benefits and account safety" Margin="0,8,0,0"/></StackPanel></Border>
          </UniformGrid>
          <GroupBox Header="Quick actions" FontSize="16" Padding="10" Margin="0,16,0,0">
            <WrapPanel>
              <Button Content="🚨 Emergency Centre" Click="Emergency_Click"/>
              <Button Content="💰 Benefits Assistant" Click="Benefits_Click"/>
              <Button Content="💊 Health Services" Click="Health_Click"/>
              <Button Content="🧾 CRA &amp; Tax" Click="Tax_Click"/>
              <Button Content="🛡 Scam Protection" Click="Safety_Click"/>
              <Button Content="📋 My Checklist" Click="Checklist_Click"/>
            </WrapPanel>
          </GroupBox>
          <Border Margin="0,18,0,0" Padding="18" Background="White" BorderBrush="#D8E1EA" BorderThickness="1" CornerRadius="10">
            <StackPanel><TextBlock Text="Important principle" FontSize="18" FontWeight="Bold"/>
              <TextBlock Text="This application is an organizer and information aid. Eligibility, medical, tax, banking and legal decisions must be confirmed with the responsible official agency or qualified professional." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem x:Name="EmergencyTab" Header="🚨 Emergency">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Emergency Centre" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="For immediate danger or a life-threatening emergency, call 911." Margin="0,5,0,18"/>
          <UniformGrid Columns="2">
            <Button Content="911 — Police / Fire / Ambulance" FontSize="20" Padding="20" Click="Call911_Click"/>
            <Button Content="811 — Health Link (24/7)" FontSize="20" Padding="20" Click="Health811_Click"/>
            <Button Content="Income Support Emergency: 1-866-644-5135" Padding="16" Click="IncomeEmergency_Click"/>
            <Button Content="Wildfire: 310-FIRE (3473)" Padding="16" Click="Fire_Click"/>
          </UniformGrid>
          <GroupBox Header="Emergency checklist" Margin="0,20,0,0" Padding="12">
            <StackPanel>
              <TextBlock Text="• Move to a safe location if possible." Margin="4"/>
              <TextBlock Text="• Call 911 for immediate danger or a life-threatening emergency." Margin="4"/>
              <TextBlock Text="• Keep your address and emergency contacts available." Margin="4"/>
              <TextBlock Text="• For health advice or information, call 811, 24/7." Margin="4"/>
              <TextBlock Text="• For emergency basic needs, contact Income Support." Margin="4"/>
            </StackPanel>
          </GroupBox>
          <Button Content="Open official Alberta Emergency Numbers" HorizontalAlignment="Left" Margin="4,15,0,0" Click="EmergencyNumbers_Click"/>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem x:Name="HealthTab" Header="💊 Health">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Health Services for Seniors" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Quick reference to Alberta health coverage and support." Margin="0,5,0,16"/>
          <GroupBox Header="Coverage for Seniors" Padding="12">
            <StackPanel>
              <TextBlock Text="Premium-free coverage is available for eligible seniors for prescription drugs and other health-related services not covered by AHCIP." TextWrapping="Wrap"/>
              <TextBlock Text="Examples include prescription drugs, ambulance services, clinical psychological services and home nursing care. Coverage rules and co-payments can change." TextWrapping="Wrap" Margin="0,8"/>
              <Button Content="Open official Coverage for Seniors page" HorizontalAlignment="Left" Click="Coverage_Click"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Health actions" Margin="0,16,0,0" Padding="12">
            <WrapPanel>
              <Button Content="Open Health Link 811" Click="Health811_Click"/>
              <Button Content="Open Seniors Health Benefits" Click="SeniorsHealth_Click"/>
              <Button Content="Open Alberta Supports" Click="AlbertaSupports_Click"/>
            </WrapPanel>
          </GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem x:Name="BenefitsTab" Header="💰 Benefits">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Senior Benefits Eligibility Assistant" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="A simple information screener. It does not determine official eligibility." Margin="0,5,0,18" Foreground="{StaticResource Muted}"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Age"/>
              <TextBox x:Name="AgeBox" Margin="0,4,0,12" Text="65"/>
              <TextBlock Text="Annual individual income (approx.)"/>
              <TextBox x:Name="IncomeBox" Margin="0,4,0,12" Text="0"/>
              <TextBlock Text="Marital status"/>
              <ComboBox x:Name="MaritalBox" Margin="0,4,0,12"><ComboBoxItem Content="Single"/><ComboBoxItem Content="Couple"/></ComboBox>
              <CheckBox x:Name="OasBox" Content="I receive OAS" Margin="0,4,0,12" IsChecked="True"/>
              <CheckBox x:Name="AlbertaBox" Content="I have lived in Alberta at least 3 months" Margin="0,4,0,12" IsChecked="True"/>
              <CheckBox x:Name="CitizenBox" Content="I am a Canadian citizen or permanent resident" Margin="0,4,0,12" IsChecked="True"/>
              <Button Content="Check Programs to Investigate" Click="RunBenefits_Click"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="18,0" Padding="15" Background="{StaticResource SoftBlue}" CornerRadius="10">
              <StackPanel>
                <TextBlock Text="Current Alberta reference points" FontWeight="Bold" FontSize="17"/>
                <TextBlock Text="• Seniors Benefit: age 65+, Alberta residency, citizenship/PR, OAS and financial eligibility." TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="• Coverage for Seniors: active AHCIP and age validation." TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="• SHARP and Property Tax Deferral have their own eligibility rules." TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="15" Background="White" BorderBrush="#D8E1EA" BorderThickness="1" CornerRadius="10">
              <StackPanel><TextBlock Text="Programs worth checking" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="BenefitsResult" Text="Enter your information and select the button." TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
          <WrapPanel Margin="0,18,0,0">
            <Button Content="Official Seniors Benefit" Click="ASB_Click"/>
            <Button Content="Seniors Financial Assistance" Click="SeniorsFinancial_Click"/>
            <Button Content="Benefits Finder (Canada)" Click="BenefitsFinder_Click"/>
          </WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem x:Name="TaxTab" Header="🧾 CRA &amp; Tax">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="CRA &amp; Income Tax Centre" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Keep federal benefits and tax information organized." Margin="0,5,0,18"/>
          <GroupBox Header="Annual tax checklist" Padding="12">
            <StackPanel>
              <TextBlock Text="☐ Gather T4A(OAS), T4A(P), pension, investment and other income slips." Margin="4"/>
              <TextBlock Text="☐ File your income tax return; filing can help maintain benefit and credit eligibility." Margin="4"/>
              <TextBlock Text="☐ Review CRA benefit and account information." Margin="4"/>
              <TextBlock Text="☐ Review direct-deposit information." Margin="4"/>
              <TextBlock Text="☐ Keep CRA contact information current." Margin="4"/>
            </StackPanel>
          </GroupBox>
          <WrapPanel Margin="0,14,0,0">
            <Button Content="CRA Benefits Finder" Click="BenefitsFinder_Click"/>
            <Button Content="CRA Direct Deposit" Click="DirectDeposit_Click"/>
            <Button Content="CRA My Account" Click="CRAMyAccount_Click"/>
            <Button Content="CRA Account Security" Click="CRAProtect_Click"/>
            <Button Content="CRA Scam Guidance" Click="CRAScam_Click"/>
          </WrapPanel>
          <Border Margin="0,18,0,0" Padding="15" Background="{StaticResource SoftGold}" CornerRadius="8">
            <TextBlock Text="Important: CPP and OAS are taxable. Current tax and benefit rules should be confirmed through official CRA and Canada.ca information." TextWrapping="Wrap"/>
          </Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="🏦 Banking">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Banking &amp; Financial Safety" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Never store passwords, PINs, full card numbers or online-banking credentials in this application." Margin="0,5,0,18"/>
          <GroupBox Header="If a card or account is compromised" Padding="12">
            <StackPanel>
              <TextBlock Text="1. Contact the bank using a trusted phone number or its official website/app." Margin="4"/>
              <TextBlock Text="2. Ask the bank to secure or replace the compromised card/account." Margin="4"/>
              <TextBlock Text="3. Review recent transactions and report unauthorized activity." Margin="4"/>
              <TextBlock Text="4. Change credentials through the bank's official channel if appropriate." Margin="4"/>
              <TextBlock Text="5. Keep the bank's incident/reference number." Margin="4"/>
            </StackPanel>
          </GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="🛡️ Scam Protection">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Scam &amp; Fraud Protector" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Pause and verify unexpected requests before paying or sharing information." Margin="0,5,0,18"/>
          <UniformGrid Columns="2">
            <Border Margin="5" Padding="15" Background="{StaticResource SoftRed}" CornerRadius="8"><StackPanel><TextBlock Text="🚩 Pressure to act immediately" FontWeight="Bold"/><TextBlock Text="Pause. Verify independently using an official number or website." TextWrapping="Wrap" Margin="0,6"/></StackPanel></Border>
            <Border Margin="5" Padding="15" Background="{StaticResource SoftRed}" CornerRadius="8"><StackPanel><TextBlock Text="🚩 Gift cards / crypto / unusual payment" FontWeight="Bold"/><TextBlock Text="Treat unexpected demands for these payment methods as a major warning sign." TextWrapping="Wrap" Margin="0,6"/></StackPanel></Border>
            <Border Margin="5" Padding="15" Background="{StaticResource SoftRed}" CornerRadius="8"><StackPanel><TextBlock Text="🚩 Passwords or security codes" FontWeight="Bold"/><TextBlock Text="Do not disclose passwords or one-time security codes to unsolicited callers." TextWrapping="Wrap" Margin="0,6"/></StackPanel></Border>
            <Border Margin="5" Padding="15" Background="{StaticResource SoftRed}" CornerRadius="8"><StackPanel><TextBlock Text="🚩 Fake government / bank caller" FontWeight="Bold"/><TextBlock Text="Hang up and contact the organization through a trusted official channel." TextWrapping="Wrap" Margin="0,6"/></StackPanel></Border>
          </UniformGrid>
          <Button Content="Open official CRA scam guidance" HorizontalAlignment="Left" Margin="5,15,0,0" Click="CRAScam_Click"/>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="🏠 Housing">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Housing &amp; Property" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Current official programs and calculators." Margin="0,5,0,18"/>
          <UniformGrid Columns="2">
            <Button Content="SHARP — Home Adaptation &amp; Repair" Click="Sharp_Click"/>
            <Button Content="SHARP Grant" Click="SharpGrant_Click"/>
            <Button Content="Property Tax Deferral" Click="TaxDeferral_Click"/>
            <Button Content="SHARP Loan Estimator" Click="SharpEstimator_Click"/>
            <Button Content="Property Tax Loan Estimator" Click="TaxEstimator_Click"/>
            <Button Content="Alberta Financial Assistance for Seniors" Click="Financial_Click"/>
          </UniformGrid>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="👨‍👩‍👧 Caregiver">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Caregiver Centre" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="A simple local-only information checklist for a trusted family member or caregiver." Margin="0,5,0,18"/>
          <GroupBox Header="Suggested record" Padding="12">
            <StackPanel>
              <TextBlock Text="Senior's name"/>
              <TextBlock Text="Primary emergency contact"/>
              <TextBlock Text="Family doctor / clinic"/>
              <TextBlock Text="Pharmacy"/>
              <TextBlock Text="Allergies and important medical notes"/>
              <TextBlock Text="Preferred hospital / care facility"/>
              <TextBlock Text="Important document locations"/>
            </StackPanel>
          </GroupBox>
          <TextBlock Text="Do not use this application as a medical record or password manager." Margin="0,18,0,0" Foreground="{StaticResource Muted}"/>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="⚖️ Legal &amp; Planning">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Legal &amp; Personal Planning" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Topics to discuss with qualified professionals and trusted family members." Margin="0,5,0,18"/>
          <UniformGrid Columns="2">
            <TextBlock Text="• Will and executor" Margin="8"/>
            <TextBlock Text="• Power of Attorney" Margin="8"/>
            <TextBlock Text="• Personal Directive" Margin="8"/>
            <TextBlock Text="• Beneficiary review" Margin="8"/>
            <TextBlock Text="• Important documents location" Margin="8"/>
            <TextBlock Text="• Emergency contacts" Margin="8"/>
            <TextBlock Text="• Digital account planning" Margin="8"/>
            <TextBlock Text="• End-of-life planning" Margin="8"/>
          </UniformGrid>
          <TextBlock Text="These are planning concepts, not legal advice. Confirm Alberta-specific requirements with an appropriate professional." Margin="8,18,8,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="📞 Contacts">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Important Alberta Numbers" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Current numbers are linked to the official Alberta emergency and supports pages." Margin="0,5,0,18"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Emergency" FontWeight="Bold" Margin="6"/><TextBlock Grid.Row="0" Grid.Column="1" Text="911" FontWeight="Bold" Margin="6"/><TextBlock Grid.Row="0" Grid.Column="2" Text="Immediate danger / life-threatening emergency" Margin="6"/>
            <TextBlock Grid.Row="1" Text="Health Link" Margin="6"/><TextBlock Grid.Row="1" Grid.Column="1" Text="811" Margin="6"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Health advice and information, 24/7" Margin="6"/>
            <TextBlock Grid.Row="2" Text="Alberta Supports" Margin="6"/><TextBlock Grid.Row="2" Grid.Column="1" Text="1-877-644-9992" Margin="6"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Seniors financial assistance and other supports" Margin="6"/>
            <TextBlock Grid.Row="3" Text="Income Support Emergency" Margin="6"/><TextBlock Grid.Row="3" Grid.Column="1" Text="1-866-644-5135" Margin="6"/><TextBlock Grid.Row="3" Grid.Column="2" Text="Emergency financial assistance, 24/7" Margin="6"/>
            <TextBlock Grid.Row="4" Text="Wildfire" Margin="6"/><TextBlock Grid.Row="4" Grid.Column="1" Text="310-FIRE (3473)" Margin="6"/><TextBlock Grid.Row="4" Grid.Column="2" Text="Report a wildfire, 24/7" Margin="6"/>
          </Grid>
          <WrapPanel Margin="0,16,0,0"><Button Content="Alberta Supports" Click="AlbertaSupports_Click"/><Button Content="Official Emergency Numbers" Click="EmergencyNumbers_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem x:Name="ChecklistTab" Header="📋 My Checklist">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Personal Senior Checklist" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Checklist status is saved locally on this Windows computer." Margin="0,5,0,18"/>
          <ListBox x:Name="ChecklistList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Title}" IsChecked="{Binding Done, Mode=TwoWay}" FontSize="16" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal"><Button Content="Save Checklist" Click="SaveChecklist_Click"/><Button Content="Reset Checklist" Click="ResetChecklist_Click"/></StackPanel>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="📚 Official Resources">
        <ScrollViewer><StackPanel Margin="20">
          <TextBlock Text="Official Resource Library" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="These links were checked against current official Alberta.ca, myhealth.alberta.ca and Canada.ca pages during v1.1 preparation." Margin="0,5,0,18" TextWrapping="Wrap"/>
          <TextBox x:Name="ResourceSearchBox" Margin="0,0,0,10" Padding="8" FontSize="15" TextChanged="ResourceSearchChanged" ToolTip="Search resources"/>
          <ListBox x:Name="ResourcesList" Height="420" DisplayMemberPath="Title"/>
          <Button Content="Open Selected Official Resource" HorizontalAlignment="Left" Click="OpenResource_Click"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>

    <StatusBar Grid.Row="2"><StatusBarItem><TextBlock Text="JASS Alberta Senior Companion v1.1 • Offline-first • No passwords, SINs or banking credentials stored"/></StatusBarItem></StatusBar>
  </Grid>
</Window>
